<?xml version="1.0" encoding="UTF-8" ?>
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Music</part-name>
    </score-part>
  </part-list>
  <!-- Slash noteheads (<notehead>slash</notehead>): rhythm slashes. The oval head is replaced by an
       oblique bar. SMuFL draws it filled for quarter and shorter, open (outlined) for half and
       whole — matching vexflow's own X/diamond duration split. All on B4 (middle line, no ledger
       lines) so only the head glyph and its fill vary.
       - M1: four quarter slashes — filled bars with stems, the common rhythm-slash strum.
       - M2: two half slashes — open bars with stems.
       - M3: one whole slash — open bar, no stem. -->
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <staves>1</staves>
        <clef>
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notehead>slash</notehead>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notehead>slash</notehead>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notehead>slash</notehead>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notehead>slash</notehead>
      </note>
    </measure>
    <measure number="2">
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>half</type>
        <notehead>slash</notehead>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>half</type>
        <notehead>slash</notehead>
      </note>
    </measure>
    <measure number="3">
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>8</duration>
        <type>whole</type>
        <notehead>slash</notehead>
      </note>
    </measure>
  </part>
</score-partwise>
