<?xml version="1.0" encoding="UTF-8" ?>
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Music</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- M1: each C5 quarter is preceded by a grace note (the grace steals no beat):
         an unslashed 16th D5 (appoggiatura), a slashed 16th D5 (acciaccatura), a
         pair of beamed 16ths (E5, D5), then an unslashed 8th D5. -->
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <staves>1</staves>
        <clef>
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <grace />
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>16th</type>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
      </note>
      <note>
        <grace slash="yes" />
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>16th</type>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
      </note>
      <note>
        <grace />
        <pitch><step>E</step><octave>5</octave></pitch>
        <type>16th</type>
        <beam number="1">begin</beam>
      </note>
      <note>
        <grace />
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>16th</type>
        <beam number="1">end</beam>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
      </note>
      <note>
        <grace />
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>eighth</type>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
      </note>
    </measure>
    <!-- M2: grace notes carrying printed accidentals — a sharp D#5 grace then a
         flat Db5 grace, each before a C5 quarter; a half rest fills the bar. -->
    <measure number="2">
      <note>
        <grace />
        <pitch><step>D</step><alter>1</alter><octave>5</octave></pitch>
        <type>16th</type>
        <accidental>sharp</accidental>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
      </note>
      <note>
        <grace />
        <pitch><step>D</step><alter>-1</alter><octave>5</octave></pitch>
        <type>16th</type>
        <accidental>flat</accidental>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
      </note>
      <note>
        <rest />
        <duration>4</duration>
        <type>half</type>
      </note>
    </measure>
    <!-- M3: a grace note slurred to its main note — an 8th D5 grace with a slur
         that hugs underneath, running head-to-head down to the C5 quarter (stem
         down); a dotted-half rest fills the bar. -->
    <measure number="3">
      <note>
        <grace />
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>eighth</type>
        <notations><slur number="1" type="start" /></notations>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notations><slur number="1" type="stop" /></notations>
      </note>
      <note>
        <rest />
        <duration>6</duration>
        <type>half</type>
        <dot />
      </note>
    </measure>
    <!-- M4: same grace slur but the main note's stem faces the other way — an 8th
         D5 grace slurred under to an E4 quarter (stem up). The slur still hugs the
         noteheads, clearing the up-stem; a dotted-half rest fills the bar. -->
    <measure number="4">
      <note>
        <grace />
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>eighth</type>
        <notations><slur number="1" type="start" /></notations>
      </note>
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notations><slur number="1" type="stop" /></notations>
      </note>
      <note>
        <rest />
        <duration>6</duration>
        <type>half</type>
        <dot />
      </note>
    </measure>
    <!-- M5: a placement override that a grace slur ignores — an 8th D5 grace with
         placement="above", yet the slur still hugs under to the C5 quarter (grace slurs
         always bow underneath); a dotted-half rest fills the bar. -->
    <measure number="5">
      <note>
        <grace />
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>eighth</type>
        <notations><slur number="1" type="start" placement="above" /></notations>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notations><slur number="1" type="stop" /></notations>
      </note>
      <note>
        <rest />
        <duration>6</duration>
        <type>half</type>
        <dot />
      </note>
    </measure>
    <!-- M6: a multi-grace slur — a beamed grace pair (E5, D5) with the slur starting
         on the first grace and running under to the C5 quarter, so one arc spans the
         whole ornament; a dotted-half rest fills the bar. -->
    <measure number="6">
      <note>
        <grace />
        <pitch><step>E</step><octave>5</octave></pitch>
        <type>16th</type>
        <beam number="1">begin</beam>
        <notations><slur number="1" type="start" /></notations>
      </note>
      <note>
        <grace />
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>16th</type>
        <beam number="1">end</beam>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notations><slur number="1" type="stop" /></notations>
      </note>
      <note>
        <rest />
        <duration>6</duration>
        <type>half</type>
        <dot />
      </note>
    </measure>
    <!-- M7: a hammer-on grace — an 8th C5 grace with a <hammer-on> up to the D5 quarter.
         In standard notation the hammer-on draws as a slur curve hugging under from the
         grace to the main note (no "H" text, which is a tab-only convention); a
         dotted-half rest fills the bar. -->
    <measure number="7">
      <note>
        <grace />
        <pitch><step>C</step><octave>5</octave></pitch>
        <type>eighth</type>
        <notations>
          <technical><hammer-on number="1" type="start">H</hammer-on></technical>
        </notations>
      </note>
      <note>
        <pitch><step>D</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notations>
          <technical><hammer-on number="1" type="stop" /></technical>
        </notations>
      </note>
      <note>
        <rest />
        <duration>6</duration>
        <type>half</type>
        <dot />
      </note>
    </measure>
    <!-- M8: a pull-off grace — an 8th D5 grace with a <pull-off> down to the C5 quarter,
         the mirror of M7. It likewise draws as a slur curve from the grace under to the
         main note; a dotted-half rest fills the bar. -->
    <measure number="8">
      <note>
        <grace />
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>eighth</type>
        <notations>
          <technical><pull-off number="1" type="start">P</pull-off></technical>
        </notations>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notations>
          <technical><pull-off number="1" type="stop" /></technical>
        </notations>
      </note>
      <note>
        <rest />
        <duration>6</duration>
        <type>half</type>
        <dot />
      </note>
    </measure>
    <!-- M9: a grace note that slides into its main note — an 8th E5 grace with a
         <slide> down to the C5 quarter, drawn as a straight diagonal line from the
         small grace notehead down to the main notehead (no arrowhead, no label); a
         dotted-half rest fills the bar. -->
    <measure number="9">
      <note>
        <grace />
        <pitch><step>E</step><octave>5</octave></pitch>
        <type>eighth</type>
        <notations><slide number="1" type="start" /></notations>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notations><slide number="1" type="stop" /></notations>
      </note>
      <note>
        <rest />
        <duration>6</duration>
        <type>half</type>
        <dot />
      </note>
    </measure>
    <!-- M10: the mirror of M9 — an 8th A4 grace with a <slide> UP to the C5 quarter,
         so the diagonal line slants up from the lower grace notehead to the main
         notehead; a dotted-half rest fills the bar. -->
    <measure number="10">
      <note>
        <grace />
        <pitch><step>A</step><octave>4</octave></pitch>
        <type>eighth</type>
        <notations><slide number="1" type="start" /></notations>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>2</duration>
        <type>quarter</type>
        <notations><slide number="1" type="stop" /></notations>
      </note>
      <note>
        <rest />
        <duration>6</duration>
        <type>half</type>
        <dot />
      </note>
    </measure>
  </part>
</score-partwise>
