        <type>quarter</type>
        <lyric number="1"><syllabic>single</syllabic><text>haste</text></lyric>
      </note>
    </measure>
    <!-- M3: the upper voice carries TWO verses and the lower one, so the lower voice's row
         starts below BOTH of the upper voice's — three rows, not two. -->
