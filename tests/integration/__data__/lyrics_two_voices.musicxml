        <duration>1</duration>
        <voice>2</voice>
        <type>quarter</type>
        <lyric number="1"><syllabic>single</syllabic><text>un</text></lyric>
      </note>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>1</duration>
        <voice>2</voice>
        <type>quarter</type>
        <lyric number="1"><syllabic>single</syllabic><text>deux</text></lyric>
