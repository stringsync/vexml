  <part id="P1">
    <!-- M1: treble, then a clef change to bass BETWEEN beats 2 and 3. Every note is a C4,
         so the change is the only reason the row moves: one ledger line below the stave
         in treble, one ledger line above it in bass. -->
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef>
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch><step>C</step><octave>4</octave></pitch>
