      </note>
      <note>
        <pitch><step>C</step><octave>4</octave></pitch>
        <duration>1</duration>
        <type>quarter</type>
      </note>
    </measure>
    <!-- M3: a clef at the END of the measure, after its last note — the courtesy clef that
