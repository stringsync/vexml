<?xml version="1.0" encoding="UTF-8" ?>
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Music</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- Notation stave over a 6-line TAB stave, 4/4: the same two slides written as voice 1
         (pitched, staff 1) and voice 2 (fretted, staff 2). The notation stave draws each as a
         straight glissando line between the noteheads; the tab stave draws a tilted TabSlide
         and erases the string line between the frets (see spanner-builder TabSlideLine). -->
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <staves>2</staves>
        <clef number="1"><sign>G</sign><line>2</line></clef>
        <clef number="2"><sign>TAB</sign><line>5</line></clef>
        <staff-details number="2"><staff-lines>6</staff-lines></staff-details>
      </attributes>
      <!-- Slide up (C4 -> D4) then slide down (E4 -> D4). -->
      <note>
        <pitch><step>C</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type><staff>1</staff>
        <notations><slide number="1" type="start" /></notations>
      </note>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type><staff>1</staff>
        <notations><slide number="1" type="stop" /></notations>
      </note>
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type><staff>1</staff>
        <notations><slide number="2" type="start" /></notations>
      </note>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type><staff>1</staff>
        <notations><slide number="2" type="stop" /></notations>
      </note>
      <backup><duration>4</duration></backup>
      <!-- The same gestures on string 3: fret 5 -> 7, then 9 -> 7. -->
      <note>
        <pitch><step>C</step><octave>4</octave></pitch>
        <duration>1</duration><voice>2</voice><type>quarter</type><staff>2</staff>
        <notations>
          <technical><string>3</string><fret>5</fret></technical>
          <slide number="3" type="start" />
        </notations>
      </note>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>1</duration><voice>2</voice><type>quarter</type><staff>2</staff>
        <notations>
          <technical><string>3</string><fret>7</fret></technical>
          <slide number="3" type="stop" />
        </notations>
      </note>
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>1</duration><voice>2</voice><type>quarter</type><staff>2</staff>
        <notations>
          <technical><string>3</string><fret>9</fret></technical>
          <slide number="4" type="start" />
        </notations>
      </note>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>1</duration><voice>2</voice><type>quarter</type><staff>2</staff>
        <notations>
          <technical><string>3</string><fret>7</fret></technical>
          <slide number="4" type="stop" />
        </notations>
      </note>
    </measure>
  </part>
</score-partwise>
