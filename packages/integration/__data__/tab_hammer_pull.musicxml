        <duration>2</duration>
        <type>eighth</type>
        <notations>
          <technical><string>1</string><fret>7</fret></technical>
          <slur number="2" type="stop" />
        </notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>eighth</type>
        <notations>
          <technical><string>1</string><fret>7</fret></technical>
          <slur number="3" type="start" />
        </notations>
      </note>
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>eighth</type>
        <notations>
          <technical><string>1</string><fret>5</fret></technical>
          <slur number="3" type="stop" />
        </notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>eighth</type>
        <notations>
          <technical><string>1</string><fret>7</fret></technical>
          <slur number="4" type="start" />
        </notations>
      </note>
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>eighth</type>
        <notations>
          <technical><string>1</string><fret>5</fret></technical>
          <slur number="4" type="stop" />
        </notations>
      </note>
    </measure>
    <!-- Sixteenth notes (string 2): a hammer-on pair then a pull-off pair at the tightest
         rhythm, closing on a pull-off "into nothing" off the final note. -->
    <measure number="6">
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>1</duration>
        <type>16th</type>
        <notations>
          <technical><string>2</string><fret>5</fret></technical>
          <slur number="1" type="start" />
        </notations>
      </note>
      <note>
        <pitch><step>F</step><alter>1</alter><octave>4</octave></pitch>
        <duration>1</duration>
        <type>16th</type>
        <notations>
          <technical><string>2</string><fret>7</fret></technical>
          <slur number="1" type="stop" />
        </notations>
      </note>
      <note>
        <pitch><step>F</step><alter>1</alter><octave>4</octave></pitch>
        <duration>1</duration>
        <type>16th</type>
        <notations>
          <technical><string>2</string><fret>7</fret></technical>
          <slur number="2" type="start" />
        </notations>
      </note>
      <!-- pulled back to fret 5, which then pulls off to the open string (fret 0). -->
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>1</duration>
        <type>16th</type>
        <notations>
          <technical><string>2</string><fret>5</fret></technical>
          <slur number="2" type="stop" />
          <slur number="5" type="start" />
        </notations>
      </note>
      <note>
        <pitch><step>B</step><octave>3</octave></pitch>
        <duration>1</duration>
        <type>16th</type>
        <notations>
          <technical><string>2</string><fret>0</fret></technical>
          <slur number="5" type="stop" />
        </notations>
      </note>
    </measure>
    <!-- A three-string chord hammering into a single note: the two sides carry different
         numbers of strings, so only the string they share (2) can be tied. -->
    <measure number="7">
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical><string>2</string><fret>5</fret></technical>
          <slur number="1" type="start" />
        </notations>
      </note>
      <note>
        <chord/>
        <pitch><step>A</step><octave>3</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical><string>3</string><fret>2</fret></technical>
        </notations>
      </note>
      <note>
        <chord/>
        <pitch><step>E</step><octave>3</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical><string>4</string><fret>2</fret></technical>
        </notations>
      </note>
      <note>
        <pitch><step>F</step><alter>1</alter><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical><string>2</string><fret>7</fret></technical>
          <slur number="1" type="stop" />
        </notations>
      </note>
    </measure>
    <!-- Written with <technical> markers only, no <slur>. A hammer-on/pull-off is a slur on a
         notation stave, so the tab stave has to draw its arc from these too — quarter notes on
         string 1, a hammer-on (5 -> 7) then a pull-off (7 -> 5). -->
    <measure number="8">
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical>
            <string>1</string><fret>5</fret>
            <hammer-on number="1" type="start">H</hammer-on>
          </technical>
        </notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical>
            <string>1</string><fret>7</fret>
            <hammer-on number="1" type="stop" />
          </technical>
        </notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical>
            <string>1</string><fret>7</fret>
            <pull-off number="2" type="start">P</pull-off>
          </technical>
        </notations>
      </note>
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical>
            <string>1</string><fret>5</fret>
            <pull-off number="2" type="stop" />
          </technical>
        </notations>
      </note>
    </measure>
    <!-- A slur AND a slide over the same pair (how MuseScore exports a slid legato run). Both
         gestures draw, so the arc has to sit clear of the diagonal instead of crossing it. -->
    <measure number="9">
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical><string>1</string><fret>5</fret></technical>
          <slur number="1" type="start" />
          <slide number="1" type="start" />
        </notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical><string>1</string><fret>7</fret></technical>
          <slur number="1" type="stop" />
          <slide number="1" type="stop" />
        </notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical><string>1</string><fret>7</fret></technical>
          <slur number="2" type="start" />
          <slide number="2" type="start" />
        </notations>
      </note>
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical><string>1</string><fret>5</fret></technical>
          <slur number="2" type="stop" />
          <slide number="2" type="stop" />
        </notations>
      </note>
    </measure>
    <!-- One <slur> over a three-note run PLUS a <technical> hammer-on/pull-off per adjacent
         pair (how MuseScore exports a legato run). The slur already arcs over the whole run,
         so the per-pair techniques must be dropped: one long arc, not a bump over each pair. -->
    <measure number="10">
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical>
            <string>1</string><fret>5</fret>
            <hammer-on number="1" type="start">H</hammer-on>
          </technical>
          <slur number="1" type="start" />
        </notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical>
            <string>1</string><fret>7</fret>
            <pull-off number="1" type="start">P</pull-off>
            <hammer-on number="1" type="stop" />
          </technical>
          <slur number="1" type="continue" />
        </notations>
      </note>
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical>
            <string>1</string><fret>5</fret>
            <pull-off number="1" type="stop" />
          </technical>
          <slur number="1" type="stop" />
        </notations>
      </note>
      <!-- Outside the slur: nothing to draw. -->
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical><string>1</string><fret>7</fret></technical>
        </notations>
      </note>
    </measure>
    <!-- M11-12: a malformed export. The second note closes slur 1 and immediately opens a
         new one that is never stopped anywhere in the part (Guitar Pro writes this). All the
         other slurs here are number 1 too, so the stray start must not swallow M12's stops:
         it has no partner and draws nothing. Written start-before-stop on the shared note,
         which is legal MusicXML and the order that trips naive pairing. -->
    <measure number="11">
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical><string>1</string><fret>5</fret></technical>
          <slur number="1" type="start" />
        </notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
          <technical><string>1</string><fret>7</fret></technical>
          <slur type="start" />
          <slur number="1" type="stop" />
        </notations>
      </note>
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>8</duration>
        <type>half</type>
        <notations>
          <technical><string>1</string><fret>5</fret></technical>
        </notations>
      </note>
    </measure>
    <measure number="12">
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>quarter</type>
        <notations>
