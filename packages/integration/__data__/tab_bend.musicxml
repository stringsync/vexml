<?xml version="1.0" encoding="UTF-8" ?>
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Music</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- 6-line TAB stave. Bends read from <bend> in <technical>, each drawn as an upward
         arrow + label. No <time>, so no time signature is drawn. -->
    <!-- A whole-step bend ("full", bend-alter 2) on string 3, then a half-step bend
         ("½", bend-alter 1) on string 2. -->
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <staves>1</staves>
        <clef>
          <sign>TAB</sign>
          <line>5</line>
        </clef>
        <staff-details>
          <staff-lines>6</staff-lines>
        </staff-details>
      </attributes>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <bend><bend-alter>2</bend-alter></bend>
          </technical>
        </notations>
      </note>
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical>
            <string>2</string><fret>5</fret>
            <bend><bend-alter>1</bend-alter></bend>
          </technical>
        </notations>
      </note>
    </measure>
    <!-- Bend and release on string 3, fret 7: bend up "full" then release back, drawn
         as an up-then-down arrow (the <release/> child adds the return leg). -->
    <measure number="2">
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <bend><bend-alter>2</bend-alter><release /></bend>
          </technical>
        </notations>
      </note>
    </measure>
    <!-- The same bend and release written as two <bend> elements, the spec's form: the
         first the bend, the second carrying <release/>. Draws like measure 2. -->
    <measure number="3">
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <bend><bend-alter>2</bend-alter></bend>
            <bend><bend-alter>2</bend-alter><release /></bend>
          </technical>
        </notations>
      </note>
    </measure>
    <!-- A words direction sharing the column with a bend: same first note as M1, plus
         "Slowly" above the stave. -->
    <measure number="4">
      <direction placement="above">
        <direction-type><words>Slowly</words></direction-type>
      </direction>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <bend><bend-alter>2</bend-alter></bend>
          </technical>
        </notations>
      </note>
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical><string>2</string><fret>5</fret></technical>
        </notations>
      </note>
    </measure>
    <!-- Angled bends (shape="angled"): the same whole-step bend as M1 and the bend and
         release of M2, drawn with straight legs instead of curves. -->
    <measure number="4">
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <bend shape="angled"><bend-alter>2</bend-alter></bend>
          </technical>
        </notations>
      </note>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <bend shape="angled"><bend-alter>2</bend-alter><release /></bend>
          </technical>
        </notations>
      </note>
    </measure>
    <!-- A pre-bend: string 3 bent a whole step before it is struck, a vertical arrow
         straight up off the fret, then the plain fret it lets down to. -->
    <measure number="5">
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <bend><bend-alter>2</bend-alter><pre-bend /></bend>
          </technical>
        </notations>
      </note>
      <note>
        <pitch><step>C</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical>
            <string>3</string><fret>5</fret>
          </technical>
        </notations>
      </note>
    </measure>
    <!-- Whammy bar: a half-step dip, then a half-step scoop, each drawn with its SMuFL
         vibrato-bar glyph (<with-bar> content "dip" / "scoop") under the "-½" label. -->
    <measure number="6">
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <bend><bend-alter>-1</bend-alter><with-bar>dip</with-bar></bend>
          </technical>
        </notations>
      </note>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>2</duration>
        <type>half</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <bend><bend-alter>-1</bend-alter><with-bar>scoop</with-bar></bend>
          </technical>
        </notations>
      </note>
    </measure>
    <!-- Whammy bar with no glyph named: an empty <with-bar/> lowering a whole step, drawn
         as a falling arrow labelled "w/bar -1". -->
    <measure number="7">
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <bend><bend-alter>-2</bend-alter><with-bar /></bend>
          </technical>
        </notations>
      </note>
    </measure>
  </part>
</score-partwise>
