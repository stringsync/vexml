    </measure>

    <!-- Measure 3: kbd-cross-staff-additional-beams (pp. 316-317) -->
    <measure number="3">
      <!-- Beat 1: two 16ths on staff 2 + two 16ths on staff 1 -->
      <note><pitch><step>G</step><octave>2</octave></pitch><duration>1</duration><voice>1</voice><type>16th</type><staff>2</staff><beam number="1">begin</beam><beam number="2">begin</beam></note>
      <note><pitch><step>B</step><octave>2</octave></pitch><duration>1</duration><voice>1</voice><type>16th</type><staff>2</staff><beam number="1">continue</beam><beam number="2">continue</beam></note>
      <note><pitch><step>D</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>16th</type><staff>1</staff><beam number="1">continue</beam><beam number="2">continue</beam></note>
