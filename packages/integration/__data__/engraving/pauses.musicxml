  <identification>
    <miscellaneous>
      <miscellaneous-field name="description">Behind Bars pp. 187-189: breath marks, caesuras, fermata size, centring, above-stave default, two-note tremolo, vertical stack order with articulations/trill/8va, mid-phrase slur, and double-stemmed voices.</miscellaneous-field>
    </miscellaneous>
  </identification>
  <part-list>
    <score-part id="P1">
