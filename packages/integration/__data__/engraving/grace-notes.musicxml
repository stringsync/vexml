      <note>
        <grace/>
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>16th</type>
        <beam number="1">end</beam>
        <beam number="2">end</beam>
      </note>
    </measure>
    <measure number="7">
      <note>
        <grace slash="yes"/>
        <pitch><step>F</step><octave>5</octave></pitch>
        <type>eighth</type>
      </note>
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>16</duration><type>whole</type></note>
    </measure>

    <!-- M8 (index 7): grace-slur-below (p. 129) — single-voice grace-note slurs curve below from notehead to notehead -->
    <measure number="8">
      <print new-system="yes"/>
      <note>
        <grace slash="yes"/>
        <pitch><step>D</step><octave>5</octave></pitch>
        <type>eighth</type>
        <notations><slur type="start" number="1"/></notations>
      </note>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>8</duration>
        <type>half</type>
        <notations><slur type="stop" number="1"/></notations>
      </note>
      <note>
        <grace/>
        <pitch><step>F</step><octave>4</octave></pitch>
        <type>16th</type>
        <beam number="1">begin</beam>
        <beam number="2">begin</beam>
        <notations><slur type="start" number="1"/></notations>
      </note>
      <note>
        <grace/>
        <pitch><step>G</step><octave>4</octave></pitch>
        <type>16th</type>
        <beam number="1">end</beam>
        <beam number="2">end</beam>
      </note>
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>8</duration>
        <type>half</type>
        <notations><slur type="stop" number="1"/></notations>
      </note>
    </measure>

    <!-- M9 (index 8): grace-slur-two-voices (p. 129) — two-voice grace slurs curve away from the stave -->
    <measure number="9">
      <note>
        <grace slash="yes"/>
        <pitch><step>F</step><octave>5</octave></pitch>
        <voice>1</voice>
        <type>eighth</type>
        <notations><slur type="start" number="1"/></notations>
      </note>
      <note>
        <pitch><step>E</step><octave>5</octave></pitch>
        <duration>16</duration>
        <voice>1</voice>
        <type>whole</type>
        <notations><slur type="stop" number="1"/></notations>
      </note>
      <backup><duration>16</duration></backup>
      <note>
        <grace slash="yes"/>
        <pitch><step>A</step><octave>4</octave></pitch>
        <voice>2</voice>
        <type>eighth</type>
        <notations><slur type="start" number="2"/></notations>
      </note>
      <note>
        <pitch><step>G</step><octave>4</octave></pitch>
        <duration>16</duration>
        <voice>2</voice>
        <type>whole</type>
        <notations><slur type="stop" number="2"/></notations>
      </note>
    </measure>

    <!-- M10 (index 9): grace-slur-clear-ledger (p. 129) — slur over ledger-line grace notes avoids obscuring ledger lines -->
    <measure number="10">
      <note>
        <grace/>
        <pitch><step>C</step><octave>6</octave></pitch>
        <type>16th</type>
        <beam number="1">begin</beam>
        <beam number="2">begin</beam>
        <notations><slur type="start" number="1"/></notations>
      </note>
      <note>
