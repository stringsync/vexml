<?xml version="1.0" encoding="UTF-8"?>
<score-partwise version="4.0">
  <identification>
    <miscellaneous>
      <miscellaneous-field name="description">Behind Bars pp. 179-181: alternating time signatures with plus and hyphen, mixed-denominator metres, and non-binary denominators.</miscellaneous-field>
    </miscellaneous>
  </identification>
  <part-list>
    <score-part id="P1">
      <part-name/>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- M1: fixed alternating metres 2/4 + 6/8 (p. 179) -->
    <measure number="1">
      <attributes>
        <divisions>4</divisions>
        <key><fifths>0</fifths></key>
        <time>
          <beats>2</beats>
          <beat-type>4</beat-type>
          <beats>6</beats>
          <beat-type>8</beat-type>
        </time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>4</duration><voice>1</voice><type>quarter</type></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>4</duration><voice>1</voice><type>quarter</type></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>eighth</type><beam number="1">begin</beam></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>eighth</type><beam number="1">continue</beam></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>eighth</type><beam number="1">end</beam></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>eighth</type><beam number="1">begin</beam></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>eighth</type><beam number="1">continue</beam></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>eighth</type><beam number="1">end</beam></note>
    </measure>
    <!-- M2: irregularly alternating metres 2/4 - 3/4 (p. 179) -->
    <measure number="2">
      <attributes>
        <time>
          <beats>2</beats>
          <beat-type>4</beat-type>
          <interchangeable>
            <time-relation>hyphen</time-relation>
            <beats>3</beats>
            <beat-type>4</beat-type>
          </interchangeable>
        </time>
      </attributes>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>4</duration><voice>1</voice><type>quarter</type></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>4</duration><voice>1</voice><type>quarter</type></note>
    </measure>
    <!-- M3: metres of mixed denominators 2/4 + 3/8 + 3/16 (p. 180) -->
    <measure number="3">
      <attributes>
        <time>
          <beats>2</beats>
          <beat-type>4</beat-type>
          <beats>3</beats>
          <beat-type>8</beat-type>
          <beats>3</beats>
          <beat-type>16</beat-type>
        </time>
      </attributes>
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>8</duration><voice>1</voice><type>half</type></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>6</duration><voice>1</voice><type>quarter</type><dot/></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>3</duration><voice>1</voice><type>eighth</type><dot/></note>
    </measure>
    <!-- M4: non-binary denominator 4/6 (pp. 180-181) -->
    <measure number="4">
      <print new-system="yes"/>
      <attributes>
        <time>
          <beats>4</beats>
          <beat-type>6</beat-type>
