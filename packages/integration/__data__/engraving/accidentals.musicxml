  <part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list>
  <part id="P1">
    <!-- M1: Grace note with a sharp before a full-size sharp. -->
    <measure number="1">
      <attributes><divisions>4</divisions><key><fifths>0</fifths></key><time><beats>4</beats><beat-type>4</beat-type></time><clef><sign>G</sign><line>2</line></clef></attributes>
      <note><grace slash="no"/><pitch><step>G</step><alter>1</alter><octave>4</octave></pitch><voice>1</voice><type>eighth</type><accidental>sharp</accidental></note>
      <note><pitch><step>F</step><alter>1</alter><octave>4</octave></pitch><duration>16</duration><voice>1</voice><type>whole</type><accidental>sharp</accidental></note>
    </measure>
    <!-- M2: Full-size sharp then a cue-size sharp. -->
    <measure number="2">
      <note><pitch><step>F</step><alter>1</alter><octave>4</octave></pitch><duration>8</duration><voice>1</voice><type>half</type><accidental>sharp</accidental></note>
      <note><cue/><pitch><step>G</step><alter>1</alter><octave>4</octave></pitch><duration>8</duration><voice>1</voice><type>half</type><accidental>sharp</accidental></note>
    </measure>
    <!-- M3: Sharps on ledger notes above and below the stave. -->
    <measure number="3">
      <note><pitch><step>C</step><alter>1</alter><octave>6</octave></pitch><duration>8</duration><voice>1</voice><type>half</type><accidental>sharp</accidental></note>
      <note><pitch><step>A</step><alter>1</alter><octave>3</octave></pitch><duration>8</duration><voice>1</voice><type>half</type><accidental>sharp</accidental></note>
    </measure>
    <!-- M4: Cautionary sharp, no parentheses attribute. -->
    <measure number="4">
      <note><pitch><step>C</step><alter>1</alter><octave>5</octave></pitch><duration>4</duration><voice>1</voice><type>quarter</type><accidental>sharp</accidental></note>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>4</duration><voice>1</voice><type>quarter</type></note>
      <note><pitch><step>C</step><alter>1</alter><octave>5</octave></pitch><duration>4</duration><voice>1</voice><type>quarter</type><accidental cautionary="yes">sharp</accidental></note>
      <note><rest/><duration>4</duration><voice>1</voice><type>quarter</type></note>
    </measure>
    <!-- M5: Chord with two cautionary sharps. -->
    <measure number="5">
      <note><pitch><step>F</step><alter>1</alter><octave>4</octave></pitch><duration>16</duration><voice>1</voice><type>whole</type><accidental cautionary="yes">sharp</accidental></note>
      <note><chord/><pitch><step>C</step><alter>1</alter><octave>5</octave></pitch><duration>16</duration><voice>1</voice><type>whole</type><accidental cautionary="yes">sharp</accidental></note>
    </measure>
    <!-- M6: Editorial sharp. -->
    <measure number="6">
      <note><pitch><step>C</step><alter>1</alter><octave>5</octave></pitch><duration>16</duration><voice>1</voice><type>whole</type><accidental editorial="yes">sharp</accidental></note>
    </measure>
    <!-- M7: Accidental-marks with no ornament. -->
    <measure number="7">
