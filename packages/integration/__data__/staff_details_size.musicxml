<score-partwise version="4.0">
  <identification>
    <miscellaneous>
      <miscellaneous-field name="description">The staff-size child of staff-details draws a staff at a percentage of normal size, as for an ossia or cue staff. The second part is a full-size staff, the first is drawn at 60 percent.</miscellaneous-field>
    </miscellaneous>
  </identification>
  <part-list>
