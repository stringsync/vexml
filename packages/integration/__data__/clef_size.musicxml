<?xml version="1.0" encoding="UTF-8" ?>
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Music</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- M1: a full-size treble clef opens the stave. -->
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef>
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
      </note>
    </measure>
    <!-- M2: a bass clef change with size full: drawn full size, not the usual small change clef. -->
    <measure number="2">
      <attributes>
        <clef size="full">
          <sign>F</sign>
          <line>4</line>
        </clef>
      </attributes>
      <note>
        <pitch><step>D</step><octave>3</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
      </note>
    </measure>
    <!-- M3: an additional treble clef, size cue: drawn small, and its line 1 ignored, so it sits
         on line 2 like any treble clef. -->
    <measure number="3">
      <attributes>
        <clef additional="yes" size="cue">
          <sign>G</sign>
          <line>1</line>
        </clef>
      </attributes>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
      </note>
    </measure>
    <!-- M4: an alto clef change with size large: drawn bigger than a full-size clef. -->
    <measure number="4">
      <attributes>
        <clef size="large">
          <sign>C</sign>
          <line>3</line>
        </clef>
      </attributes>
      <note>
        <pitch><step>C</step><octave>4</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
      </note>
    </measure>
  </part>
</score-partwise>
