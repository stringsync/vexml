        <duration>4</duration>
        <type>whole</type>
        <staff>2</staff>
      </note>
    </measure>
    <!-- M4: to F major (1 flat), cancel -3 location right: the flat, then naturals on E and A. -->
    <measure number="4">
      <attributes>
        <key>
          <cancel location="right">-3</cancel>
          <fifths>-1</fifths>
        </key>
      </attributes>
      <note>
