    <!-- M2: to D major (2 sharps) with no cancel: the replaced key's dropped sharps (D#, G#) get
         naturals, left of the new key. -->
    <measure number="2">
      <attributes>
        <key>
          <fifths>2</fifths>
        </key>
      </attributes>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
