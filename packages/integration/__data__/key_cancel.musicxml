        <duration>4</duration>
        <type>whole</type>
        <staff>2</staff>
      </note>
    </measure>
    <!-- M3: to E flat major (3 flats), cancel 2 (D major): naturals on F and C, then the flats. -->
    <measure number="3">
      <attributes>
        <key>
          <cancel>2</cancel>
          <fifths>-3</fifths>
        </key>
      </attributes>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
