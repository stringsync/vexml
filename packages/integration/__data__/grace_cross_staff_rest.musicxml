  <part id="P1">
    <!-- M1: a staff-2 grace note in voice 1 leads a voice 1 half note written on staff 1,
         while staff 2 holds only a measure rest in voice 5. The bass staff has no main
         note of that voice to attach the grace to, so it hangs off the beat the voice holds
         there: a slashed G3 grace slurred up into the treble G4. -->
    <measure number="1">
      <attributes>
        <divisions>4</divisions>
        <time>
          <beats>6</beats>
          <beat-type>8</beat-type>
        </time>
        <staves>2</staves>
