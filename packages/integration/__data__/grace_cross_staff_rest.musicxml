          <sign>G</sign>
          <line>2</line>
        </clef>
        <clef number="2">
          <sign>F</sign>
          <line>4</line>
        </clef>
      </attributes>
      <note>
        <grace slash="yes" />
        <pitch><step>G</step><octave>3</octave></pitch>
        <voice>1</voice>
        <type>eighth</type>
        <stem>up</stem>
        <staff>2</staff>
        <notations><slur type="start" orientation="over" number="1" /></notations>
      </note>
      <note>
