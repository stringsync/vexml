<?xml version="1.0" encoding="UTF-8" ?>
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Music</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- Treble stave, 4/4: <glissando> start/stop pairs on a notation stave.
         M1: a glissando up (C4 -> E4) then down (G4 -> D4), each a straight line between the
         two noteheads.
         M2: a glissando that starts at the end of the bar and stops on the first note of M3's
         opening, crossing the barline.
         M3: the stop of M2's glissando, then a lone stop with no start (a glissando into the
         note). -->
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note>
        <pitch><step>C</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type>
        <notations><glissando number="1" type="start"/></notations>
      </note>
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type>
        <notations><glissando number="1" type="stop"/></notations>
      </note>
      <note>
        <pitch><step>G</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type>
        <notations><glissando number="1" type="start"/></notations>
      </note>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type>
        <notations><glissando number="1" type="stop"/></notations>
      </note>
    </measure>
    <measure number="2">
      <note>
        <rest/>
        <duration>3</duration><voice>1</voice><type>half</type><dot/>
      </note>
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type>
        <notations><glissando number="1" type="start"/></notations>
      </note>
    </measure>
    <measure number="3">
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type>
        <notations><glissando number="1" type="stop"/></notations>
      </note>
      <note>
        <rest/>
        <duration>1</duration><voice>1</voice><type>quarter</type>
      </note>
      <note>
        <pitch><step>F</step><octave>4</octave></pitch>
