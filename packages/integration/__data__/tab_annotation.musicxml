  <part id="P1">
    <!-- 6-line TAB stave. Text annotations above the frets come from <other-technical>.
         No <time>, so no time signature is drawn. -->
    <!-- A leading rest, then a palm mute ("P.M.") and a dead note ("x"), then a trailing
         rest. -->
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <staves>1</staves>
        <clef>
          <sign>TAB</sign>
          <line>5</line>
        </clef>
        <staff-details>
          <staff-lines>6</staff-lines>
        </staff-details>
      </attributes>
      <note>
        <rest />
        <duration>1</duration>
        <type>quarter</type>
      </note>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>1</duration>
        <type>quarter</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <other-technical>P.M.</other-technical>
          </technical>
        </notations>
      </note>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>1</duration>
        <type>quarter</type>
        <notations>
          <technical>
            <string>3</string><fret>7</fret>
            <other-technical>x</other-technical>
          </technical>
        </notations>
      </note>
      <note>
        <rest />
        <duration>1</duration>
        <type>quarter</type>
      </note>
    </measure>
    <!-- A chord symbol over a slurred pair on the top string: the arc bows into the band the
         words would sit in, so the words have to lift over it. -->
    <measure number="2">
      <direction placement="above">
        <direction-type><words>Dm</words></direction-type>
      </direction>
      <note>
        <pitch><step>A</step><octave>4</octave></pitch>
        <duration>1</duration>
        <type>quarter</type>
        <notations>
          <slur type="start" number="1" />
          <technical><string>1</string><fret>5</fret></technical>
        </notations>
      </note>
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>1</duration>
        <type>quarter</type>
        <notations>
          <slur type="stop" number="1" />
          <technical><string>1</string><fret>7</fret></technical>
        </notations>
      </note>
      <note>
        <rest />
