  <identification>
    <miscellaneous>
      <miscellaneous-field name="description">A swung tune with a one-eighth
          pickup: sound/swing 2:1 at quarter=60. M1 is plain eighths, which
          swing; M2 mixes them with a written-out triplet, which must not be
          swung a second time. Drives the playback timing test, not a
          screenshot.</miscellaneous-field>
    </miscellaneous>
